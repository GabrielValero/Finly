      "checkConstraints": {
        "tx_amount_nonzero": {
          "name": "tx_amount_nonzero",
          "value": "\"transactions\".\"amount_minor\" <> 0"
        },
        "tx_sign_matches_kind": {
          "name": "tx_sign_matches_kind",
          "value": "(\"transactions\".\"kind\" = 'expense' AND \"transactions\".\"amount_minor\" < 0) OR (\"transactions\".\"kind\" = 'income' AND \"transactions\".\"amount_minor\" > 0) OR \"transactions\".\"kind\" = 'transfer'"
        },
        "tx_transfer_link": {
          "name": "tx_transfer_link",
          "value": "(\"transactions\".\"kind\" = 'transfer') = (\"transactions\".\"transfer_id\" IS NOT NULL)"
        },
        "tx_category_required": {
          "name": "tx_category_required",
          "value": "\"transactions\".\"kind\" = 'transfer' OR \"transactions\".\"category_id\" IS NOT NULL"
        },
        "tx_listed_pair": {
          "name": "tx_listed_pair",
          "value": "(\"transactions\".\"listed_amount_minor\" IS NULL) = (\"transactions\".\"listed_currency\" IS NULL)"
        },
        "tx_rate_pair": {
          "name": "tx_rate_pair",
          "value": "(\"transactions\".\"rate_scaled\" IS NULL) = (\"transactions\".\"rate_source\" IS NULL)"
        },
        "tx_rate_rule": {
          "name": "tx_rate_rule",
          "value": "\"transactions\".\"kind\" = 'transfer' OR (\n        (\"transactions\".\"account_currency\" = 'VES' OR (\"transactions\".\"listed_currency\" IS NOT NULL AND \"transactions\".\"listed_currency\" <> \"transactions\".\"account_currency\"))\n        = (\"transactions\".\"rate_scaled\" IS NOT NULL)\n      )"
        }
      }
