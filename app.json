{
  "expo": {
    "name": "Finly",
    "slug": "finly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gabrielvalero.finly"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "finly",
    "backgroundColor": "#0A0A0B",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir a Finly usar Face ID para desbloquear la app."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "eaf3555d-fa92-490c-8537-8dd7af2d1e78"
      }
    },
    "owner": "gabriel-valero-team",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/eaf3555d-fa92-490c-8537-8dd7af2d1e78",
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0
    }
  }
}
